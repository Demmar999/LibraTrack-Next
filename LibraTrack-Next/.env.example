# Copy this file to .env.local and change the values.

# Secret used to sign login cookies. Use a long random text in real use.
SESSION_SECRET=change-me-to-a-long-random-text

# Time zone used for "today", due dates and fines.
APP_TIMEZONE=Asia/Manila

